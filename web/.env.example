# Public RPC override (default: Monad Testnet public RPC)
NEXT_PUBLIC_RPC_URL=

# Optional disposable TESTNET-ONLY burner key, public to all app visitors.
# Never use a valuable key. The UI labels this convenience explicitly.
NEXT_PUBLIC_DEMO_KEY=

# Canonical public origin for OpenGraph asset links on production deployment.
NEXT_PUBLIC_SITE_URL=

# Optional verified public GitHub repository link (https://github.com/owner/repo)
NEXT_PUBLIC_GITHUB_URL=

# Optional comma-separated wallet addresses trusted as configured publishers.
# This allowlist does not prove that media depicts a real event.
NEXT_PUBLIC_TRUSTED_PUBLISHERS=
