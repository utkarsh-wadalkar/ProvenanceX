{
  "app": {
    "baseUrl": "http://127.0.0.1:3002",
    "devCommand": "node demos/hackathon-demo/start-local.mjs",
    "viewport": {"width": 1920, "height": 1080}
  },
  "auth": {"loginRequired": false},
  "cursor": {"scale": 1.6, "color": "#F5F2FF"},
  "camera": {"padding": 0.18, "maxZoom": 1.6, "transitionSec": 0.72},
  "speedup": {"toolWaitMax": 2, "preToolWaitMax": 2, "idleGapMin": 9999, "idleGapMax": 3},
  "frame": {"preset": "studio-dark", "canvasWidth": 1920, "canvasHeight": 1080, "wallpaper": null, "radius": 0, "titlebarHeight": 0},
  "narration": {"provider": "kie", "voiceName": "Rachel", "modelId": "elevenlabs/text-to-speech-turbo-2-5", "stability": 0.5, "apiKeyEnv": "KIE_API_KEY"},
  "captions": {"enabled": true, "maxCharsPerLine": 46},
  "output": {"dir": "demos"}
}
